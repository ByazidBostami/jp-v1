# Copy to .env and adjust for your environment
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Field encryption key for passport/national-ID (use a 32+ char secret)
FIELD_ENCRYPTION_KEY=change-me-too

# Database: leave DB_ENGINE unset (or =sqlite) for dev; set =mysql for production
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=japancareer
# DB_USER=root
# DB_PASSWORD=secret
# DB_HOST=127.0.0.1
# DB_PORT=3306
